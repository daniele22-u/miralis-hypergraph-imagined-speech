    "# Path configuration function with subject-specific bypass\n",
    "def get_data_paths(subject_name: str = None) -> Dict[str, Path]:\n",
    "    \"\"\"\n",
    "    Get data paths with subject-specific overrides.\n",
    "    \n",
    "    For subject 'daniele', uses OneDrive path.\n",
    "    For other subjects, uses default project paths.\n",
    "    \n",
    "    Args:\n",
    "        subject_name: Name of the subject (e.g., 'daniele')\n",
    "    \n",
    "    Returns:\n",
    "        Dictionary with 'h5_dir' and 'eloc_path'\n",
    "    \"\"\"\n",
    "    paths = {}\n",
    "    \n",
    "    # Electrode locations file - always in src/io\n",
    "    paths['eloc_path'] = project_root / \"src\" / \"io\" / \"ebneuro.elocs\"\n",
    "    \n",
    "    # H5 data files path - subject-specific bypass\n",
    "    if subject_name and subject_name.lower() == 'daniele':\n",
    "        # Bypass for daniele: use OneDrive path\n",
    "        paths['h5_dir'] = Path('/Users/danieleuras/Library/CloudStorage/OneDrive-PolitecnicodiMilano/File di Francesco Iacomi - h5/data')\n",
    "        print(f\"✓ Using daniele-specific path: {paths['h5_dir']}\")\n",
    "    else:\n",
    "        # Default path for other subjects\n",
    "        paths['h5_dir'] = project_root / \"data\" / \"processed\"\n",
    "        print(f\"✓ Using default path: {paths['h5_dir']}\")\n",
    "    \n",
    "    # Verify paths exist\n",
    "    if not paths['eloc_path'].exists():\n",
    "        print(f\"⚠ Warning: Electrode file not found at {paths['eloc_path']}\")\n",
    "    if not paths['h5_dir'].exists():\n",
    "        print(f\"⚠ Warning: H5 directory not found at {paths['h5_dir']}\")\n",
    "    \n",
    "    return paths\n",
    "\n",
    "# Configure paths - CHANGE THIS TO YOUR SUBJECT NAME\n",
    "SUBJECT_NAME = 'daniele'  # Change to 'daniele' to use OneDrive path, or None for default\n",
    "paths = get_data_paths(SUBJECT_NAME)\n",
    "\n",
    "print(f\"\\n📁 Configuration:\")\n",
    "print(f\"   Electrode file: {paths['eloc_path']}\")\n",
    "print(f\"   H5 data dir: {paths['h5_dir']}\")"
   ]
