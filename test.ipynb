    "import matlab.engine\n",
    "\n",
    "print(\"⏳ Starting MATLAB...\")\n",
    "eng = matlab.engine.start_matlab()\n",
    "print(\"✅ MATLAB connected!\")\n",
    "\n",
    "eng.eval(\"disp('Hello from MATLAB!')\", nargout=0)\n",
    "\n",
    "eng.quit()\n",
